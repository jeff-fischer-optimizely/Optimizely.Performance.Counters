## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Keep the local package feed's folder even though build/ is ignored and no .nupkg is ever
# committed. examples/NuGet.config names build/nupkg as a source, and NuGet fails restore outright
# when a local source path is missing - so on a fresh clone the example would die with NU1301
# instead of the useful "package not found" you get once the folder exists.
!build/
build/*
!build/nupkg/
build/nupkg/*
!build/nupkg/.gitkeep

# Build results
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core
.dotnet/
