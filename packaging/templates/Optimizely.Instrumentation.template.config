<?xml version="1.0" encoding="utf-8"?>
<!--
  Optimizely.Performance.Counters - settings template for CMS 11.

  Merge the <add> elements below into the <appSettings> element of your site's web.config. Every
  value shown is the default, so a site that copies them all behaves exactly as it does with no
  configuration at all - keep the lines you are changing and delete the rest.

  The key paths are the same ones a CMS 12 or CMS 13 site writes into appsettings.json, so a site
  that upgrades carries its settings across unchanged. Anything under Optimizely:Instrumentation
  that the package does not recognise is logged as a warning at startup, so a typo is visible
  rather than silent.

  Plain appSettings keys rather than a configuration section of their own, unlike
  Optimizely.Performance.DotNetCounters, which uses one. That package configures a list of
  counters, which XML expresses well; everything here is a single value.

  Three settings below never do anything on this version and are listed only so the file matches
  its V12/V13 counterpart: the GarbageCollection and Contention probes need runtime APIs .NET
  Framework does not have, and the CacheLock probe has no lock to find because CMS 11 caches
  through System.Web rather than through IMemoryCache.
-->
<appSettings>

  <!-- The master switch. False and nothing is decorated, no probe starts, and no counter is
       registered with Application Insights - the modules log one line each and return. -->
  <add key="Optimizely:Instrumentation:Enabled" value="true" />

  <!-- Thread pool queue delay probe. The one probe that runs on CMS 11. -->
  <add key="Optimizely:Instrumentation:Probes:ThreadPool:Enabled" value="true" />
  <add key="Optimizely:Instrumentation:Probes:ThreadPool:SampleIntervalSeconds" value="5" />
  <add key="Optimizely:Instrumentation:Probes:ThreadPool:SampleTimeoutSeconds" value="10" />
  <add key="Optimizely:Instrumentation:Probes:ThreadPool:SlowSampleThresholdMilliseconds" value="100" />
  <add key="Optimizely:Instrumentation:Probes:ThreadPool:LogsPerMinute" value="4" />

  <!-- Garbage collection pause probe. .NET 6 and later only; inert here. -->
  <add key="Optimizely:Instrumentation:Probes:GarbageCollection:Enabled" value="true" />
  <add key="Optimizely:Instrumentation:Probes:GarbageCollection:SampleIntervalSeconds" value="5" />
  <add key="Optimizely:Instrumentation:Probes:GarbageCollection:SlowPauseThresholdMilliseconds" value="200" />
  <add key="Optimizely:Instrumentation:Probes:GarbageCollection:LogsPerMinute" value="4" />

  <!-- Lock contention probe. .NET 6 and later only; inert here. -->
  <add key="Optimizely:Instrumentation:Probes:Contention:Enabled" value="true" />
  <add key="Optimizely:Instrumentation:Probes:Contention:BurstCaptureEnabled" value="true" />
  <add key="Optimizely:Instrumentation:Probes:Contention:SampleIntervalSeconds" value="5" />
  <add key="Optimizely:Instrumentation:Probes:Contention:BurstTriggerContentionsPerSecond" value="500" />
  <add key="Optimizely:Instrumentation:Probes:Contention:BurstDurationSeconds" value="3" />
  <add key="Optimizely:Instrumentation:Probes:Contention:BurstCooldownSeconds" value="300" />
  <add key="Optimizely:Instrumentation:Probes:Contention:MaxBurstsPerHour" value="6" />
  <add key="Optimizely:Instrumentation:Probes:Contention:MaxSamplesPerBurst" value="20000" />
  <add key="Optimizely:Instrumentation:Probes:Contention:LogsPerMinute" value="2" />

  <!-- Cache lock probe. Finds no lock on CMS 11; inert here. -->
  <add key="Optimizely:Instrumentation:Probes:CacheLock:Enabled" value="true" />
  <add key="Optimizely:Instrumentation:Probes:CacheLock:SampleIntervalSeconds" value="2" />
  <add key="Optimizely:Instrumentation:Probes:CacheLock:QueueDepthThreshold" value="10" />
  <add key="Optimizely:Instrumentation:Probes:CacheLock:LogsPerMinute" value="4" />

  <!-- Cache dependency cascade. Not instrumented on CMS 11; inert here. -->
  <add key="Optimizely:Instrumentation:Cache:Cascade:Enabled" value="true" />
  <add key="Optimizely:Instrumentation:Cache:Cascade:LargeRemovalThreshold" value="1000" />
  <add key="Optimizely:Instrumentation:Cache:Cascade:LogLargeRemovals" value="true" />
  <add key="Optimizely:Instrumentation:Cache:Cascade:LargeRemovalLogsPerMinute" value="10" />
  <add key="Optimizely:Instrumentation:Cache:Cascade:FailureThreshold" value="20" />

  <!--
    Log write rate. Fully working on CMS 11, unlike most of the above: the three
    Optimizely.Runtime.Logging.* counters are fed by an appender this package adds to the root
    logger of every configured log4net repository, so both the EPiServerLog.config and the inline
    <log4net> section arrangements are counted. Nothing to configure beyond this switch; false
    removes the appender and the counters and leaves logging exactly as it was.
  -->
  <add key="Optimizely:Instrumentation:Logging:Enabled" value="true" />

  <!--
    Outbound response cacheability. Fully working on CMS 11 as well: the measurement is an HTTP
    module that this package adds to the pipeline itself through PreApplicationStartMethod, so
    there is no <system.webServer><modules> entry to add - installing the package installs it.

    Integrated pipeline only. Classic mode has no managed response header collection, so the
    module finds nothing to read and subscribes to nothing rather than failing per request.

    False removes the nine Optimizely.Runtime.Http.* counters. The module stays in the pipeline -
    ASP.NET builds that list once, before this setting has been read - but it does nothing beyond
    one volatile read per request.
  -->
  <add key="Optimizely:Instrumentation:Http:Enabled" value="true" />
  <add key="Optimizely:Instrumentation:Http:LogSharedCacheConflicts" value="true" />
  <add key="Optimizely:Instrumentation:Http:SharedCacheConflictLogsPerMinute" value="5" />
  <add key="Optimizely:Instrumentation:Http:FailureThreshold" value="20" />

  <!--
    Meter publication. Has no effect on CMS 11: .NET Framework has no
    System.Diagnostics.Metrics, so the counters leave the process over the
    Optimizely-Performance EventSource and nothing else, whatever this is set to.

    It is listed here so that one settings file serves all three majors. On CMS 12 and CMS 13 this
    switch controls a second publication path - the same counter names on a meter named
    Optimizely-Performance - which is what OpenTelemetry, UseAzureMonitor() and Application
    Insights SDK 3.x collect, none of them being able to read an EventCounter at all.
  -->
  <add key="Optimizely:Instrumentation:Meter:Enabled" value="true" />

  <!--
    Deployed assembly reporting. The only node in this file that is not about a counter, and one
    of the few that works exactly the same on CMS 11 as on CMS 12 and CMS 13: it reads the bin
    folder, which every version has.

    At startup and on a heartbeat the bin folder is scanned and reduced to a 16-character
    fingerprint over every assembly's identity - its MVID, the compiler's own id for the exact
    bits, so a rebuild of the same version reads as a change and a version bump without a rebuild
    does not. Four events are emitted under names starting OptiCounters., and the fingerprint is
    stamped onto every telemetry item as a DeploymentFingerprint custom dimension.

    Where those events go differs on this version. A CMS 11 site with Application Insights gets
    them through TelemetryConfiguration.Active; a site without it gets them in the log instead,
    through log4net like everything else. The log is a perfectly good answer to "what is in the
    bin folder on this server" - it is only the querying that needs Application Insights.

    StatePath is where the last manifest is kept so the next start can diff against it. Left
    empty it probes for somewhere writable and reports the choice on every event. On CMS 11 the
    first candidate is the site's own App_Data - a real directory that a bin deployment does not
    touch - so change detection usually works properly here, which it does not on a container host
    where every release replaces the disk.
  -->
  <add key="Optimizely:Instrumentation:Deployment:Enabled" value="true" />
  <add key="Optimizely:Instrumentation:Deployment:StatePath" value="" />
  <add key="Optimizely:Instrumentation:Deployment:InventoryMode" value="OnChange" />
  <add key="Optimizely:Instrumentation:Deployment:HeartbeatMinutes" value="15" />
  <add key="Optimizely:Instrumentation:Deployment:InventoryReemitHours" value="168" />
  <add key="Optimizely:Instrumentation:Deployment:IncludeSystemAssemblies" value="true" />
  <add key="Optimizely:Instrumentation:Deployment:IncludeFilePaths" value="false" />
  <add key="Optimizely:Instrumentation:Deployment:StampTelemetry" value="true" />
  <add key="Optimizely:Instrumentation:Deployment:MaxChangeEvents" value="200" />
  <add key="Optimizely:Instrumentation:Deployment:MaxAssemblies" value="2000" />

</appSettings>
