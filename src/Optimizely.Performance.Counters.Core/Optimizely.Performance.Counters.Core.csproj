<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Optimizely.Performance.Counters.Core</PackageId>
    <Description>Core infrastructure for Optimizely performance counters - shared by CMS and Commerce packages</Description>
  </PropertyGroup>

  <!--
    The Microsoft.Extensions.* line tracks the runtime, so its version has to move with the target
    framework rather than being pinned once for all six. It was pinned at 6.0.0 globally, which is a
    downgrade on net10.0: Optimizely.Performance.DotNetCounters asks for 10.0.0 there, and NuGet
    treats the downgrade as an error, so the net10.0 build could not restore at all.

    Matching each target framework to its own band also keeps a net9.0 or net10.0 host from loading
    a 6.0.0 assembly over the one already in its shared framework.
  -->
  <PropertyGroup>
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net472'">6.0.0</ExtensionsVersion>
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net6.0'">6.0.0</ExtensionsVersion>
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net7.0'">7.0.0</ExtensionsVersion>
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.0</ExtensionsVersion>
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.0</ExtensionsVersion>
    <!-- 10.0.2, not 10.0.0, for the reason described under the net10.0 ItemGroup below. -->
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.2</ExtensionsVersion>
  </PropertyGroup>

  <!-- Common dependencies (all frameworks) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(ExtensionsVersion)" />
    <!--
      Abstractions only, and only for IConfiguration itself. InstrumentationConfiguration binds by
      hand rather than through Microsoft.Extensions.Configuration.Binder, because the binder cannot
      be used on net472 - there is no IConfiguration on a V11 site to bind from - and because it
      ignores unrecognised keys, which is the one thing a settings file most needs to be told about.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Optimizely.Performance.DotNetCounters" Version="1.0.0" />
  </ItemGroup>

  <!--
    net10.0 only, and none of it used by this assembly. Optimizely.Performance.DotNetCounters 1.0.0
    carries a downgrade inside its own graph on this target framework: it names the Microsoft.Extensions
    packages at 10.0.0 directly, while the EPiServer.CMS.Core 13.0.0 it also depends on requires 10.0.2.
    Nearest-wins picks 10.0.0, and NU1605 is an error, so Core cannot restore in Release at all -
    dotnet pack fails before it builds anything.

    NU1605's own remedy is to reference the package directly and choose the version, which is what
    this does. It adds nothing a consumer was not already resolving through DotNetCounters; it only
    lifts the floor to the one CMS 13 actually needs. Remove it once DotNetCounters raises its own.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(ExtensionsVersion)" />
  </ItemGroup>

  <!-- .NET Framework - EventSource/EventCounter support, and the configuration V11 actually has -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.0" />
    <!-- ConfigurationManager.AppSettings, which is where InstrumentationConfiguration reads the
         settings from on a V11 site. -->
    <Reference Include="System.Configuration" />
    <!--
      Only for Log4NetWriteRateSink, which implements log4net's IAppender at runtime rather than
      at compile time. .NET Framework has no DispatchProxy of its own - it shipped with .NET Core -
      so on this one target framework it comes from a package. The .NET builds have it in the
      shared framework and must not reference the package, which is why this is not global.
    -->
    <PackageReference Include="System.Reflection.DispatchProxy" Version="4.7.1" />
    <!-- HttpCacheabilityModule: the V11 half of the outbound response cacheability counters is an
         IHttpModule, so this target framework - and only this one - compiles against System.Web. -->
    <Reference Include="System.Web" />
    <!--
      DynamicModuleUtility, which is how that module gets into the pipeline without the site adding
      a line to web.config. There is no other supported way to register a module programmatically,
      and requiring a web.config edit would make this the only part of the package that is not
      installed by installing the package.

      1.0.0 rather than 2.0.0 because it is the version already in the graph on a V11 site - ASP.NET
      MVC 5 and WebPages both depend on it - so on the sites this target framework exists for, this
      reference resolves to an assembly that was going to be in bin anyway.
    -->
    <PackageReference Include="Microsoft.Web.Infrastructure" Version="1.0.0" />
  </ItemGroup>

  <!--
    The V12 and V13 half of the same feature is ASP.NET Core middleware and an IStartupFilter, so
    those target frameworks need the request pipeline abstractions.

    Packages rather than <FrameworkReference Include="Microsoft.AspNetCore.App" />, which is the
    modern spelling and is wrong here. A framework reference makes NuGet prune every package the
    shared framework already contains - which includes all three Microsoft.Extensions.* references
    above - out of the dependency graph and out of the produced nuspec. Core would still compile,
    but its package would declare no dependency on Microsoft.Extensions.Logging.Abstractions, so any
    consumer without the ASP.NET Core shared framework would get an assembly whose references
    nothing satisfies. The CMS and Commerce projects, which get those packages through Core, stopped
    compiling outright.

    These two are the last netstandard2.0 versions and are old on purpose: they are only needed for
    their type shapes. A real ASP.NET Core host has the same assemblies in its shared framework at a
    far higher version, and NuGet's package-override mechanism drops these in favour of it - so on
    the sites this exists for, nothing is downloaded and nothing is deployed. The pruning that is
    wrong to trigger inside Core is exactly right when the consumer triggers it.

    The version has to move with the target framework, like the Microsoft.Extensions line above and
    for the opposite reason. On net10.0 both packages are already in the graph at 2.3.0 -
    EPiServer.CMS.Core 13 reaches them through Microsoft.AspNetCore.StaticFiles - and naming them
    lower is a downgrade, which this repository builds with as an error. On net6.0 through net9.0
    nothing else in the graph asks for them, and 2.3.0 would be the one asking: its own dependencies
    name Microsoft.Extensions.Hosting.Abstractions 8.0.1, which drags the whole Extensions line up to
    8.0.2 and collides head-on with the 6.x range EPiServer 12 pins. 2.2.0 depends on the 2.2.0
    Extensions packages, which are below every floor in the graph and change nothing.

    net10.0 is unaffected by that pull because its Extensions line is already 10.0.2, well above the
    8.0.1 the newer package asks for.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472' And '$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Hosting.Abstractions" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Hosting.Abstractions" Version="2.3.0" />
  </ItemGroup>

  <!--
    net472 only, and only for OptimizelyPerformanceEventSource.WriteMetricEvent. That target
    framework has no EventCounter to write through, so every measurement goes out as a raw ETW
    event, and EventSource has no WriteEvent(int, string, double) overload to carry it - the call
    binds to WriteEvent(int, params object[]), which allocates an array and boxes the double on
    every measurement. WriteEventCore takes a stack buffer instead, and needs a pointer to do it.

    Deliberately not global: nothing else in this repository is unsafe, and the .NET Core builds
    have no reason to be.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    For PortableExecutableReader, which parses the PE and CLI metadata headers by hand to read a
    module's MVID. It is internal on purpose: byte offsets into ECMA-335 are not API surface this
    package wants to support, and the one caller is the inventory scanner.

    It is also the highest-risk code in the package - a misread offset produces a plausible GUID
    rather than an error, and the deployment fingerprint built on it would look stable while meaning
    nothing - so it is the code that most needs testing directly against a real assembly, rather
    than through a scanner that would hide the difference. Unambiguous here in a way it would not be
    for the linked shared source; see the note in the test project.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Optimizely.Performance.Counters.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
