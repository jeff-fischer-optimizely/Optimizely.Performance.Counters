<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Optimizely.Performance.Counters.Commerce</PackageId>
    <Description>Performance counters for Optimizely Commerce V11, V12, and V13 - Orders, Pricing, Inventory, Promotions</Description>
  </PropertyGroup>

  <!-- Define compilation symbols -->
  <PropertyGroup>
    <DefineConstants Condition="'$(TargetFramework)' == 'net472'">$(DefineConstants);CMS11;COMMERCE13</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net6.0' Or '$(TargetFramework)' == 'net7.0' Or '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">$(DefineConstants);CMS12;COMMERCE14</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0'">$(DefineConstants);CMS13;COMMERCE15</DefineConstants>
  </PropertyGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\Optimizely.Performance.Counters.Core\Optimizely.Performance.Counters.Core.csproj" />
    <!-- Core includes Optimizely.Performance.DotNetCounters as transitive dependency -->
  </ItemGroup>

  <!-- See the matching comment in the CMS project: shared initialization support, linked. -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- Common dependencies -->
  <ItemGroup>
    <!-- Logging version flows from Optimizely packages -->
  </ItemGroup>

  <!-- .NET Framework 4.7.2 (V11 / Commerce 13) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="EPiServer.Commerce.Core" Version="$(CommerceV13Version)" PrivateAssets="compile" />
    <PackageReference Include="EPiServer.Framework" Version="$(OptimizelyV11Version)" PrivateAssets="compile" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <!-- .NET 6-7 (V12 / Commerce 14) - Commerce 14.46 dropped these two targets. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0' Or '$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="EPiServer.Commerce.Core" Version="$(CommerceV14LegacyVersion)" PrivateAssets="compile" />
    <PackageReference Include="EPiServer.Framework" Version="$(OptimizelyV12Version)" PrivateAssets="compile" />
  </ItemGroup>

  <!-- .NET 8-9 (V12 / Commerce 14) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="EPiServer.Commerce.Core" Version="$(CommerceV14Version)" PrivateAssets="compile" />
    <PackageReference Include="EPiServer.Framework" Version="$(OptimizelyV12Version)" PrivateAssets="compile" />
  </ItemGroup>

  <!-- .NET 10+ (V13 / Commerce 15) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="EPiServer.Commerce.Core" Version="$(CommerceV15Version)" PrivateAssets="compile" />
    <PackageReference Include="EPiServer.Framework" Version="$(OptimizelyV13Version)" PrivateAssets="compile" />
  </ItemGroup>

</Project>
