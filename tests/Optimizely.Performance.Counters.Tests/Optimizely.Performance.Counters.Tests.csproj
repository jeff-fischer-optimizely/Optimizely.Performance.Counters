<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Every target framework the packages ship, less net7.0. The three majors are the point -
         net472 = V11, net6.0-net9.0 = V12, net10.0 = V13 - and within the V12 band every target now
         compiles against the same Optimizely versions, so what the four of them still prove is the
         runtime rather than the references. That is worth keeping: the counters are EventCounters,
         and EventCounter, CounterGroup and the polling behaviour underneath them are BCL types that
         changed across .NET 6 to 9.

         net7.0 is left out because it is out of support and adds nothing net6.0 does not already
         cover. Everything else here is a target somebody could actually be running. -->
    <TargetFrameworks>net472;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The decorators are deliberately full of pass-throughs; XML docs are not useful here. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Mirror the version symbols the projects under test use, so the tests can assert
       version-specific shapes. -->
  <PropertyGroup>
    <DefineConstants Condition="'$(TargetFramework)' == 'net472'">$(DefineConstants);CMS11;COMMERCE13</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net6.0' Or '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">$(DefineConstants);CMS12;COMMERCE14</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0'">$(DefineConstants);CMS13;COMMERCE15</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Optimizely.Performance.Counters.Core\Optimizely.Performance.Counters.Core.csproj" />
    <ProjectReference Include="..\..\src\Optimizely.Performance.Counters.CMS\Optimizely.Performance.Counters.CMS.csproj" />
    <ProjectReference Include="..\..\src\Optimizely.Performance.Counters.Commerce\Optimizely.Performance.Counters.Commerce.csproj" />
  </ItemGroup>

  <!-- DeferredLogger is internal, and it is linked source rather than a type in Core, so it exists
       once inside each of the CMS and Commerce assemblies. Neither copy is reachable from here and
       InternalsVisibleTo on both would make the name ambiguous. Compiling the same file is how
       linked shared source gets tested; ModuleSupport is not linked because it needs the CMSxx
       symbols and the EPiServer initialization types. -->
  <ItemGroup>
    <Compile Include="..\..\src\Shared\DeferredLogger.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- The projects under test set PrivateAssets="compile" on their Optimizely references, so the
       compile-time assemblies do not flow here. The tests reference them directly at the same
       versions. -->

  <!-- .NET Framework 4.7.2 (V11 / Commerce 13) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="EPiServer.CMS.Core" Version="$(OptimizelyV11Version)" />
    <PackageReference Include="EPiServer.Framework" Version="$(OptimizelyV11Version)" />
    <PackageReference Include="EPiServer.Commerce.Core" Version="$(CommerceV13Version)" />
    <!-- DispatchProxy is not in the .NET Framework BCL; the test doubles are built on it. -->
    <PackageReference Include="System.Reflection.DispatchProxy" Version="4.7.1" />
    <!-- V11 has no IServiceCollection. Its container is StructureMap, and the container tests
         build a real one so Intercept is exercised the way a V11 site exercises it. -->
    <PackageReference Include="EPiServer.ServiceLocation.StructureMap" Version="2.0.3" />
    <!-- Referenced by the tests only, and for the same reason Application Insights is below: Core
         reaches log4net purely by reflection and must keep doing so, because log4net's assembly
         version tracks its package version and a compile-time reference would bind Core to one
         exact identity. Only a real log4net can tell whether that reflection still binds.

         2.0.8 is the floor of the range EPiServer.Logging.Log4Net 2.2.2 depends on, so this is the
         oldest log4net a V11 site can be running - the version the reflection has to work against
         if it is to work at all. -->
    <PackageReference Include="log4net" Version="2.0.8" />
  </ItemGroup>

  <!-- .NET 6-9 (V12 / Commerce 14). One Commerce version across the band, mirroring the Commerce
       project - see the note there for why the old net6.0/net8.0 split went away. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0' Or '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="EPiServer.CMS.Core" Version="$(OptimizelyV12Version)" />
    <PackageReference Include="EPiServer.Framework" Version="$(OptimizelyV12Version)" />
    <PackageReference Include="EPiServer.Commerce.Core" Version="$(CommerceV14Version)" />
  </ItemGroup>

  <!-- .NET 10 (V13 / Commerce 15) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="EPiServer.CMS.Core" Version="$(OptimizelyV13Version)" />
    <PackageReference Include="EPiServer.Framework" Version="$(OptimizelyV13Version)" />
    <PackageReference Include="EPiServer.Commerce.Core" Version="$(CommerceV15Version)" />
  </ItemGroup>

  <!--
    Application Insights, referenced by the tests only. Core reaches it purely by reflection and
    must keep doing so - it is an optional dependency, and a site without it has to load Core
    without dragging the AI assemblies in. Reflection is also why this reference has to exist here:
    the binding is resolved by string at runtime, so nothing but a real EventCounterCollectionModule
    can tell whether it still binds. See ApplicationInsightsRegistrationTests.

    2.23.0, the last of the 2.x line, on both target frameworks. It is netstandard2.0, so it loads
    on either. The 3.x line is deliberately not tested here because there is nothing in it to test:
    3.0 re-based the SDK on OpenTelemetry and dropped EventCounterCollectionModule,
    ConfigureTelemetryModule and the whole telemetry-module concept, so the registration in Core has
    no counterpart there at all. Supporting it is a feature, not a version bump - see the note in
    docs/SMOKE_TEST.md.

    The AspNetCore package is not referenced on net472: V11 has no IServiceCollection, so the
    ConfigureTelemetryModule path this brings in does not exist there. The PerfCounterCollector
    package is referenced instead, because the one thing V11 does have a registration path for is
    the SQL connection pool counters - Windows performance counters, collected through a
    PerformanceCollectorModule that WindowsPerformanceCounterRegistration builds itself. Same
    reasoning as above: only a real module can tell whether the reflection still binds. See
    WindowsPerformanceCounterRegistrationTests.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.ApplicationInsights.PerfCounterCollector" Version="2.23.0" />
  </ItemGroup>

</Project>
