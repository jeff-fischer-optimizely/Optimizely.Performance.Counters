<?xml version="1.0" encoding="utf-8"?>
<!--
  Lines to merge into a CMS 11 site's web.config. Not a drop-in file.

  Nothing here is required by Optimizely.Performance.Counters.CMS - the initialization module is
  discovered automatically and runs correctly with none of it. This is the Application Insights
  wiring, plus one optional switch that changes what ADO.NET publishes.

  In particular there is no <system.webServer><modules> entry to add. The package measures outbound
  response cacheability with an IHttpModule, and it registers that module itself through
  PreApplicationStartMethod - installing the package installs it. It needs an integrated-mode
  application pool; in classic mode there is no managed response header collection to read and the
  module subscribes to nothing.

  The package does read settings, from Optimizely:Instrumentation:* keys in appSettings, but every
  one of them has a default and none is needed to run. The complete set is written to
  App_Data\Optimizely.Performance.Counters\Optimizely.Instrumentation.template.config on install;
  copy across only what you want to change. The one worth knowing is in the appSettings block
  below, commented out.

  See the caveat in README.md: the AI subscription for this package's own counters is not implemented
  on V11, so they reach the Optimizely-Performance EventSource but not the AI
  EventCounterCollectionModule. The SQL connection pool counters are the exception and do reach AI.
-->
<configuration>

  <appSettings>
    <!-- Preferred. Connection strings replaced bare instrumentation keys in AI 2.x. -->
    <add key="APPLICATIONINSIGHTS_CONNECTION_STRING"
         value="InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://REGION.in.applicationinsights.azure.com/" />

    <!--
      Switches the whole package off: nothing is decorated, no probe starts, no appender is added to
      log4net, the response cacheability module goes inert, and the only trace left is one line in
      the log saying so. Here so that ruling this package out during an incident is a setting rather
      than a deployment.
    -->
    <!-- <add key="Optimizely:Instrumentation:Enabled" value="false" /> -->
  </appSettings>

  <system.diagnostics>
    <!--
      Optional, and the only setting here that changes what is collected rather than where it goes.

      ADO.NET publishes NumberOfActiveConnections, NumberOfFreeConnections, SoftConnectsPerSecond and
      SoftDisconnectsPerSecond only when this switch is Verbose - the four that answer "how full is
      the pool". Without it they do not error; they read a constant zero, which on a chart looks
      exactly like an idle pool. This package reads the same switch and collects them only when it is
      on, so a missing series means "not collected" rather than "nothing happening".

      4 is TraceLevel.Verbose, the only value ADO.NET accepts. Restart the application pool after
      changing it: the counters are created during provider initialization, not on demand.
    -->
    <switches>
      <add name="ConnectionPoolPerformanceCounterDetail" value="4" />
    </switches>

    <!--
      Turn this on while you are confirming the counters work, then take it back out. The module logs
      which telemetry systems it detected, every decorator it registered, and the detected versus
      expected Optimizely version - which is the fastest way to tell "not collecting" apart from
      "not instrumented".
    -->
    <trace autoflush="true">
      <listeners>
        <add name="OptimizelyPerformanceCounters"
             type="System.Diagnostics.TextWriterTraceListener"
             initializeData="App_Data\performance-counters.log" />
      </listeners>
    </trace>
  </system.diagnostics>

</configuration>
