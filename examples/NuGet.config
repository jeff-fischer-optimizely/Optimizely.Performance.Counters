<?xml version="1.0" encoding="utf-8"?>
<!--
  Feeds for the example projects. Scoped to this folder so a locally built 1.0.0 is never picked up
  by the packages themselves - only by things that consume them.

  local-build points at what "dotnet pack -c Release -o build/nupkg" produces at the repo root. Once
  the packages are published, drop it and the examples resolve from the real feed unchanged.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-build" value="..\build\nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Optimizely" value="https://nuget.optimizely.com/feed/packages.svc/" />
  </packageSources>
</configuration>
